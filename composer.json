{
    "name": "ultraviolettes/flux-datatable",
    "description": "A standalone, Tailwind+Livewire DataTable wrapper with Flux UI styling for Laravel",
    "keywords": ["laravel","datatable","livewire","flux","tailwind"],
    "license": "MIT",
    "authors": [
        {
            "name": "Ultraviolettes",
            "email": "dev@ultraviolettes.fr"
        }
    ],
    "homepage": "https://github.com/ultraviolettes/flux-datatable",
    "require": {
        "php": "^8.5",
        "illuminate/contracts": "^13.0",
        "livewire/flux": "^2.16",
        "livewire/flux-pro": "^2.16",
        "livewire/livewire": "^4.0",
        "spatie/laravel-data": "^4.17",
        "spatie/laravel-package-tools": "^1.16"
    },
    "require-dev": {
        "larastan/larastan": "^3.0",
        "laravel/pint": "^1.14",
        "livewire/blaze": "^1.0",
        "nunomaduro/collision": "^8.1.1",
        "orchestra/testbench": "^11.0.0",
        "pestphp/pest": "^4.0",
        "pestphp/pest-plugin-arch": "^4.0",
        "pestphp/pest-plugin-laravel": "^4.0",
        "pestphp/pest-plugin-livewire": "^4.0",
        "phpstan/extension-installer": "^1.4",
        "phpstan/phpstan-deprecation-rules": "^2.0",
        "phpstan/phpstan-phpunit": "^2.0",
        "spatie/laravel-ray": "^1.35"
    },
    "autoload": {
        "psr-4": {
            "Ultraviolettes\\FluxDataTable\\": "src/",
            "Ultraviolettes\\FluxDataTable\\Database\\Factories\\": "database/factories/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Ultraviolettes\\FluxDataTable\\Tests\\": "tests/",
            "Workbench\\App\\": "workbench/app/"
        }
    },
    "scripts": {
        "post-autoload-dump": "@composer run prepare",
        "prepare": "@php vendor/bin/testbench package:discover --ansi",
        "analyse": "vendor/bin/phpstan analyse",
        "test": "vendor/bin/pest",
        "test-coverage": "vendor/bin/pest --coverage",
        "format": "vendor/bin/pint"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "phpstan/extension-installer": true
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Ultraviolettes\\FluxDataTable\\FluxDataTableServiceProvider"
            ],
            "aliases": {
                "FluxDataTable": "Ultraviolettes\\FluxDataTable\\Facades\\FluxDataTable"
            }
        }
    },
    "repositories": {
        "flux-pro": {
            "type": "composer",
            "url": "https://composer.fluxui.dev"
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
